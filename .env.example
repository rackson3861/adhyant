# Copy this file to .env and fill in your values.
# Never commit .env (it’s in .gitignore).

# Apps Script web app URL (recordings, test sign-up, test submission, etc.)
VITE_RECORDING_UPLOAD_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Optional: alternate URL for test submission (falls back to VITE_RECORDING_UPLOAD_URL if unset)
# VITE_TEST_SUBMISSION_URL=

# Admin dashboard secret (validates admin API calls)
VITE_ADMIN_SECRET=your-admin-secret

# Optional: admin login (defaults: admin / adhyant2025)
# VITE_ADMIN_USER=admin
# VITE_ADMIN_PASSWORD=adhyant2025

# Optional: API base URL (e.g. for FeedbackAll)
# VITE_API_URL=http://localhost:3000
